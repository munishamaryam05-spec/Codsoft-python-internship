    "def todo_list():\n",
    "    tasks = []\n",
    "    while True:\n",
    "        print(\"====================\")\n",
    "        print(\"    TO-DO LIST      \")\n",
    "        print(\"====================\")\n",
    "        print(\"1. View Tasks\")\n",
    "        print(\"2. Add Task\")\n",
    "        print(\"3. Update Task\")\n",
    "        print(\"4. Mark Task as Done\")\n",
    "        print(\"5. Delete Task\")\n",
    "        print(\"6. Exit\")\n",
    "        \n",
    "        choice = input(\"Enter your choice: \")\n",
    "        \n",
    "        if choice == \"1\":\n",
    "            print(\"-----------------------\")\n",
    "            print(\"    YOUR TASK LIST     \")\n",
    "            print(\"-----------------------\")\n",
    "            if not tasks:\n",
    "                print(\"No tasks found!\")\n",
    "            else:\n",
    "                print(\"\\nYour Tasks:\\n\")\n",
    "                for i, task in enumerate(tasks, 1):\n",
    "                    status = \"Done\" if task[\"done\"] else \"Pending\"\n",
    "                    print(f\"{i}. {task['name']:<25} [{status}]\\n\")\n",
    "        \n",
    "        elif choice == \"2\":\n",
    "            print(\"-----------------------\")\n",
    "            print(\"     ADD NEW TASK      \")\n",
    "            print(\"-----------------------\")\n",
    "            task_name = input(\"Enter task: \")\n",
    "            tasks.append({\"name\": task_name, \"done\": False})\n",
    "            print(f\"Task '{task_name}' added Successfully!\")\n",
    "    \n",
    "        elif choice == \"3\":\n",
    "            print(\"-----------------------------\")\n",
    "            print(\"    UPDATE EXISTING TASK     \")\n",
    "            print(\"-----------------------------\")\n",
    "            if not tasks:\n",
    "                print(\"No tasks to update!\")\n",
    "            else:\n",
    "                for i, task in enumerate(tasks, 1):\n",
    "                    print(f\"{i}. {task['name']}\")\n",
    "                num = int(input(\"Enter task number to update: \")) - 1\n",
    "                new_name = input(\"Enter new task name: \")\n",
    "                tasks[num][\"name\"] = new_name\n",
    "                print(\"Task updated Successfully!\")\n",
    "        \n",
    "        elif choice == \"4\":\n",
    "            print(\"------------------------------\")\n",
    "            print(\"   MARK TASK AS COMPLETED   \")\n",
    "            print(\"------------------------------\")\n",
    "            if not tasks:\n",
    "                print(\"No tasks available!\")\n",
    "            else:\n",
    "                for i, task in enumerate(tasks, 1):\n",
    "                    print(f\"{i}. {task['name']}\")\n",
    "                num = int(input(\"Enter task number to mark as done: \")) - 1\n",
    "                tasks[num][\"done\"] = True\n",
    "                print(\"Task marked as done Successfully!\")\n",
    "        \n",
    "        elif choice == \"5\":\n",
    "            print(\"--------------------\")\n",
    "            print(\"    DELETE TASK     \")\n",
    "            print(\"--------------------\")\n",
    "            if not tasks:\n",
    "                print(\"No tasks to delete!\")\n",
    "            else:\n",
    "                for i, task in enumerate(tasks, 1):\n",
    "                    print(f\"{i}. {task['name']}\")\n",
    "                num = int(input(\"Enter task number to delete: \")) - 1\n",
    "                removed = tasks.pop(num)\n",
    "                print(f\"Task '{removed['name']}' deleted Successfully!\")\n",
    "        \n",
    "        elif choice == \"6\":\n",
    "            print(\"Thankyou for using TO-DO list!\")\n",
    "            break\n",
    "        \n",
    "        else:\n",
    "            print(\"Invalid choice! Try again.\")\n",
    "\n",
    "todo_list()"
   ]
