    "                num = int(input(\"  Enter Contact Number to Delete : \")) - 1\n",
    "                if 0 <= num < len(contacts):\n",
    "                    removed = contacts.pop(num)\n",
    "                    print(f\"\\n  Contact '{removed['name']}' has been deleted successfully.\")\n",
