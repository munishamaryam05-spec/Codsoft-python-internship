    "import random  \n",
    "import string \n",
    "def display_menu():\n",
    "    print(\"\\n\")\n",
    "    print(\"=======================================\")\n",
    "    print(\"        PASSWORD GENERATOR APP         \")\n",
    "    print(\"=======================================\")\n",
    "    print(\"  1. Generate New Password             \")\n",
    "    print(\"  2. Exit                              \")\n",
    "    print(\"=======================================\")\n",
    "\n",
    "def select_complexity():\n",
    "    print(\"\\n------------------------------------------\")\n",
    "    print(\"         SELECT PASSWORD COMPLEXITY       \")\n",
    "    print(\"------------------------------------------\")\n",
    "    print(\"  1. Basic   - Letters Only               \")\n",
    "    print(\"  2. Medium  - Letters + Numbers          \")\n",
    "    print(\"  3. Strong  - Letters + Numbers + Symbols\")\n",
    "    print(\"------------------------------------------\")\n",
    "    \n",
    "    complexity = input(\"  Please Select Complexity (1/2/3) : \") \n",
    "    if complexity == \"1\": \n",
    "        characters = string.ascii_letters\n",
    "        level = \"Basic\"\n",
    "    elif complexity == \"2\":  \n",
    "        characters = string.ascii_letters + string.digits\n",
    "        level = \"Medium\"\n",
    "    elif complexity == \"3\": \n",
    "        characters = string.ascii_letters + string.digits + string.punctuation\n",
    "        level = \"Strong\"\n",
    "    else:\n",
    "        print(\"\\n  Invalid selection. Please choose 1, 2, or 3.\")\n",
    "        return None, None \n",
    "    \n",
    "    return characters, level  \n",
    "def generate_password():\n",
    "    print(\"\\n------------------------------------------\")\n",
    "    print(\"           GENERATE NEW PASSWORD          \")\n",
    "    print(\"------------------------------------------\")\n",
    "    try:\n",
    "        length = int(input(\"  Enter Desired Password Length : \")) \n",
    "        \n",
    "        if length < 4:  \n",
    "            print(\"\\n  Password length must be at least 4 characters.\")\n",
    "            return\n",
    "        \n",
    "        characters, level = select_complexity()  \n",
    "        \n",
    "        if characters is None:  \n",
    "            return\n",
    "        password = ''.join(random.choice(characters) for _ in range(length))\n",
    "        print(\"\\n------------------------------------------\")\n",
    "        print(\"           PASSWORD GENERATED             \")\n",
    "        print(\"------------------------------------------\")\n",
    "        print(f\"  Password Length     : {length}\")\n",
    "        print(f\"  Complexity Level    : {level}\")\n",
    "        print(f\"  Generated Password  : {password}\")\n",
    "        print(\"------------------------------------------\")\n",
    "    \n",
    "    except ValueError: \n",
    "        print(\"\\n  Invalid input. Please enter a valid number for length.\")\n",
    "\n",
    "def password_generator():\n",
    "    while True: \n",
    "        display_menu() \n",
    "        choice = input(\"  Please Select an Option (1-2) : \") \n",
    "        \n",
    "        if choice == \"1\":  \n",
    "            generate_password()\n",
    "        elif choice == \"2\":   \n",
    "            print(\"\\n==========================================\")\n",
    "            print(\"  Thank you for using Password Generator. \")\n",
    "            print(\"==========================================\\n\")\n",
    "            break \n",
    "        else:\n",
    "            print(\"\\n  Invalid option. Please select 1 or 2.\")\n",
    "password_generator()"
   ]
